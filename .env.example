# Public contact form uses Firebase Cloud Function sendSupportContact
# (Firestore template: emailTemplates/supportContact + Microsoft SMTP).
# No frontend env vars required for support email.

# Optional — only used as fallback for admin approval/rejection emails
# if the sendEmail Cloud Function fails:
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
